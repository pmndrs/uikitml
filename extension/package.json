{
  "name": "uikitml-vscode",
  "displayName": "UIKitML for VS Code",
  "publisher": "threejs-uikit",
  "description": "",
  "version": "0.1.3",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmndrs/uikitml.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:uikitml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "uikitml",
        "extensions": [
          ".uikitml"
        ],
        "aliases": [
          "UIKit Markup Language",
          "UIKitML"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "uikitml",
        "scopeName": "text.html.uikitml",
        "path": "./syntaxes/uikitml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "uikit-preview.showPreview",
        "title": "UIKit: Preview"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "uikit-preview.showPreview",
          "when": "resourceExtname == .uikitml",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "uikit-preview.showPreview",
          "when": "resourceExtname == .uikitml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "uikit-preview.showPreview",
          "when": "resourceExtname == .uikitml",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "uikitml": "html"
      }
    },
    "configuration": {
      "type": "object",
      "title": "UIKit Markup Language",
      "properties": {
        "uikitml.validate": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable uikitml validation"
        },
        "uikitml.completion": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable uikitml auto-completion"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out --skipLibCheck",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/jest": "^29.5.14",
    "@types/js-beautify": "^1.14.3",
    "@types/lodash": "^4.17.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/three": "^0.178.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^13.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.0.2",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.3",
    "mocha": "^11.5.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@pmndrs/msdfonts": "^1.0.59",
    "@pmndrs/pointer-events": "^6.6.14",
    "@pmndrs/uikit": "^1.0.59",
    "@pmndrs/uikit-default": "^1.0.59",
    "@pmndrs/uikit-horizon": "^1.0.59",
    "@pmndrs/uikit-lucide": "^1.0.59",
    "@pmndrs/uikitml": "workspace:^",
    "@preact/signals-core": "^1.11.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "js-beautify": "^1.15.4",
    "juice": "^11.0.1",
    "lodash": "^4.17.21",
    "parse5": "^7.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0",
    "zustand": "^5.0.5"
  }
}
